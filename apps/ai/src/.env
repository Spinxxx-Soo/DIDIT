# AI

# 포트 설정
APP_NAME="AI Service API"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 이슈 모델 설정
MODEL_ISSUE_PRIORITY_COMMIT=spinxxxx/git-issues-priority-ko
USE_RULES=true

# 배치 설정
MAX_BATCH_SIZE=100

# Redis 설정 (파이썬 문법 제거)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2

# 로깅 설정
LOG_LEVEL=INFO