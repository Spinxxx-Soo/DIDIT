MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=admin
MYSQL_USER=user
MYSQL_PASSWORD=user
GITHUB_CLIENT_ID=id
GITHUB_CLIENT_SECRET=secret
OPENVIDU_URL="https://localhost:4443"
OPENVIDU_SECRET=secret
OPENVIDU_WEBHOOK_TOKEN=secret
OPENVIDU_WEBHOOK=true
OPENVIDU_WEBHOOK_ENDPOINT=https://api.example.com/api/v1/webhooks/openvidu
OPENVIDU_WEBHOOK_HEADERS=["X-OpenVidu-Token: my-secret-token"]
OPENVIDU_WEBHOOK_EVENTS=["sessionCreated","sessionDestroyed","participantJoined","participantLeft","webrtcConnectionCreated","webrtcConnectionDestroyed","recordingStatusChanged","filterEventDispatched","signalSent"]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret

